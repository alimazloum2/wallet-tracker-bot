# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Blockchain API Keys
ETHERSCAN_API_KEY=your_etherscan_api_key
BSCSCAN_API_KEY=your_bscscan_api_key  # OPTIONAL - BSC now uses Ankr RPC (no key needed)
SOLSCAN_API_KEY=your_solscan_api_key

# Note:
# - Bitcoin uses BlockCypher API which doesn't require an API key
# - BSC now uses Ankr RPC endpoint which doesn't require an API key
